<UserControl x:Class="FFUBuilder.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FFUBuilder.App.Converters">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StatusToIconConverter x:Key="StatusToIcon" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:DurationToStringConverter x:Key="DurationToStr" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Preflight Dashboard"
                           FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Environment readiness checks"
                           FontSize="14" Foreground="Gray" Margin="0,2,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Command="{Binding RunAllChecksCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="16,8"
                    FontSize="14" />
        </DockPanel>

        <!-- Summary banner -->
        <Border Grid.Row="1"
                Padding="12,8"
                CornerRadius="4"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F5F5F5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCriticalFailures}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding SummaryText}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Margin="12,0,0,0" FontSize="13">
                        <Run Text="{Binding PassedCount, Mode=OneWay}" Foreground="#2E7D32" FontWeight="Bold" />
                        <Run Text=" passed" Foreground="#2E7D32" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" FontSize="13"
                               Visibility="{Binding FailedCount, Converter={StaticResource BoolToVis}}">
                        <Run Text="{Binding FailedCount, Mode=OneWay}" Foreground="#C62828" FontWeight="Bold" />
                        <Run Text=" failed" Foreground="#C62828" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" FontSize="13"
                               Visibility="{Binding WarningCount, Converter={StaticResource BoolToVis}}">
                        <Run Text="{Binding WarningCount, Mode=OneWay}" Foreground="#F57F17" FontWeight="Bold" />
                        <Run Text=" warnings" Foreground="#F57F17" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Check list grouped by category -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GroupedChecks}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,10,8,6"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#424242" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#EEEEEE"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Status icon -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Status, Converter={StaticResource StatusToIcon}}"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                           FontSize="16"
                                           VerticalAlignment="Center" />

                                <!-- Name and message -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   FontWeight="Medium" />
                                        <TextBlock Text="{Binding Duration, Converter={StaticResource DurationToStr}}"
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="12"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Repair button -->
                                <Button Grid.Column="2"
                                        Content="Fix"
                                        Command="{Binding DataContext.RepairCheckCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsRepairable, Converter={StaticResource BoolToVis}}"
                                        Padding="12,4"
                                        Margin="8,0"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Status badge -->
                                <Border Grid.Column="3"
                                        CornerRadius="3"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11"
                                               Foreground="White"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading overlay -->
        <Border Grid.Row="2"
                Background="#80FFFFFF"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Running checks..."
                           FontSize="16"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
