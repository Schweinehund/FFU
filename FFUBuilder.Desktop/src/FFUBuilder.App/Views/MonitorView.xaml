<UserControl x:Class="FFUBuilder.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FFUBuilder.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Build Monitor"
                       FontSize="24" FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Real-time build progress and log output"
                       FontSize="14" Foreground="Gray"
                       Margin="0,0,0,12" />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Start Build" Command="{Binding StartBuildCommand}"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="#2E7D32" Foreground="White" FontWeight="SemiBold" />
            <Button Content="Cancel" Command="{Binding CancelBuildCommand}"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="#C62828" Foreground="White" />
            <Button Content="Clear Log" Command="{Binding ClearLogCommand}"
                    Padding="12,6" Margin="0,0,16,0" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="13" />
        </StackPanel>

        <!-- Progress section -->
        <Grid Grid.Row="2" Margin="0,0,0,12"
              Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0" Height="24"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Margin="0,0,0,4" />

            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ProgressActivity}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                           Margin="8,0" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ElapsedTime}"
                           Foreground="Gray" />
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{Binding ProgressStatus}"
                       Foreground="Gray" FontSize="12" />
        </Grid>

        <!-- Elapsed time when not building (shows last build time) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibility}}">
        </StackPanel>

        <!-- Log viewer -->
        <Border Grid.Row="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <ListView ItemsSource="{Binding LogEntries}"
                      x:Name="LogListView"
                      FontFamily="Consolas" FontSize="12"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                       Foreground="Gray" Margin="0,0,8,0"
                                       FontFamily="Consolas" />
                            <TextBlock Text="{Binding Level, StringFormat=[{0}]}"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"
                                       FontFamily="Consolas"
                                       Width="90" />
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                       TextWrapping="NoWrap"
                                       FontFamily="Consolas" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
