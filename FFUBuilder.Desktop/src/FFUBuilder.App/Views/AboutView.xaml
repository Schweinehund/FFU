<UserControl x:Class="FFUBuilder.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header section -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,16,0,24">
            <TextBlock Text="FFU Builder"
                       FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />

            <TextBlock Text="{Binding AppVersion}"
                       FontSize="18" Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />

            <TextBlock Text="{Binding BuildDate}"
                       FontSize="13" Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />

            <TextBlock Text="{Binding Description}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,12" />

            <TextBlock FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                <Run Text="Native C# WPF application (.NET 8)" />
                <LineBreak />
                <Run Text="{Binding PsVersion, Mode=OneWay}" />
                <LineBreak />
                <Run Text="MIT License" />
            </TextBlock>
        </StackPanel>

        <!-- Loaded modules list -->
        <GroupBox Grid.Row="1" Header="PowerShell Modules" Padding="8">
            <ListView ItemsSource="{Binding Modules}"
                      BorderThickness="0"
                      FontSize="12">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Module" Width="180"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Version" Width="80"
                                        DisplayMemberBinding="{Binding Version}" />
                        <GridViewColumn Header="Status" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                                        <Setter Property="Text" Value="Loaded" />
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                                                        <Setter Property="Text" Value="Not loaded" />
                                                        <Setter Property="Foreground" Value="#757575" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Description" Width="350"
                                        DisplayMemberBinding="{Binding Description}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</UserControl>
