<Window x:Class="FFUBuilder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FFUBuilder.App.Views"
        Title="{Binding Title}"
        Width="1100" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main content with left tab navigation -->
        <TabControl Grid.Row="0"
                    TabStripPlacement="Left"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Padding="8">

            <TabItem Header="Home" Style="{StaticResource NavTabItem}">
                <views:DashboardView />
            </TabItem>

            <TabItem Header="Settings" Style="{StaticResource NavTabItem}">
                <views:SettingsView />
            </TabItem>

            <TabItem Header="Monitor" Style="{StaticResource NavTabItem}">
                <views:MonitorView />
            </TabItem>

            <TabItem Header="About" Style="{StaticResource NavTabItem}">
                <views:AboutView />
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
